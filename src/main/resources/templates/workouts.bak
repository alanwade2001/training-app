<!doctype html>

<html
        lang="en-IE"
        xmlns:th="http://www.thymeleaf.org">

<head>
    <meta charset="UTF-8">

    <meta
            name="viewport"
            content="width=device-width, initial-scale=1">

    <title>Training</title>
</head>

<body>

<h1>Training</h1>

<h2>Ready to train?</h2>

<article th:each="workout : ${workouts}">
    <h3 th:text="${workout.name}">
        Heavy Force
    </h3>
    <p>
            <span
                    th:text="${workout.exercises.size()}">
                3
            </span>
        exercises
    </p>
    <form
            th:action="@{/sessions}"
            method="post">
        <input
                type="hidden"
                name="workoutId"
                th:value="${workout.id}">

        <button type="submit">
            START WORKOUT
        </button>
    </form>
</article>
</body>
</html>